[Unit]
Description=AR Files Background Sync and VFS Daemon
Documentation=https://github.com/ar-files/ar-files
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ar-files --daemon
Restart=on-failure
RestartSec=5s
Slice=app-graphical.slice
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
